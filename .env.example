# ==========================================
# FinOps 엔진 환경변수 설정 샘플 (.env.example)
# ==========================================

# 서버 포트 설정
PORT=8080

# API 인증 토큰 (실제 토큰 대신 예시 문구를 적어둡니다)
ALERT_API_TOKEN=your_secret_api_token_here

# 메일 서버 설정
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=alert@example.com
SMTP_TO=admin@example.com
